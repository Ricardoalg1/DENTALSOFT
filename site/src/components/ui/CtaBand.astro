---
interface Props { eyebrow?: string; title: string; text?: string }
const { eyebrow = "Tu próximo paso", title, text } = Astro.props;
---

<section class="wrap pb-10 pt-4" data-reveal="zoom">
  <div class="cta-x flex flex-wrap items-center justify-between gap-6 px-7 py-9 sm:px-12 sm:py-11">
    <div class="max-w-xl">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="mt-3 text-2xl font-semibold leading-tight tracking-tight sm:text-3xl">{title}</h2>
      {text && <p class="mt-2 text-sm leading-7 text-white/80">{text}</p>}
    </div>
    <div class="flex flex-wrap gap-3"><slot /></div>
  </div>
</section>
