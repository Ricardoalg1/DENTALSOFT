---
import Icon from "../Icon.astro";
// [columna 1-3, fila 1-6 (08:00-13:00), desplazamiento en horas, hora, nombre, tratamiento, color]
const events: [number, number, number, string, string, string, string][] = [
  [1, 2, 0, "09:00", "Ana María Torres", "Control de rutina", "#3d85d6"],
  [1, 3, 0, "10:00", "Luis Cano", "Valoración", "#2a9d8f"],
  [1, 5, 0.5, "11:30", "Carolina Pérez", "Profilaxis", "#2fa37a"],
  [2, 1, 0, "08:00", "David Ruiz", "Control", "#d9638a"],
  [2, 3, 0.5, "10:30", "Laura Gómez", "Endodoncia", "#e08a2b"],
  [2, 5, 0, "12:00", "Carlos Mena", "Ortodoncia", "#2a9d8f"],
  [3, 1, 0.5, "08:30", "Sofía Restrepo", "Limpieza", "#3d85d6"],
  [3, 4, 0, "11:00", "Jorge Ríos", "Consulta", "#8a6fd6"],
];
const hours = ["08:00", "09:00", "10:00", "11:00", "12:00", "13:00"];
const days = ["Lun 5", "Mar 6", "Mié 7"];
---

<div class="mock mock-card cal anim" role="img" aria-label="Vista ilustrativa de la agenda semanal con citas de ejemplo">
  <div class="cal-head">
    <span class="inline-flex items-center gap-1.5"><Icon name="calendar" class="size-4 text-primary" />Octubre 2026</span>
    <span class="cal-tabs"><span class="on">Día</span><span>Semana</span><span>Mes</span></span>
  </div>
  <div class="cal-grid">
    <span></span>
    {days.map((d) => <span class="cal-day">{d}</span>)}
    {hours.map((h, r) => (
      <>
        <span class="cal-hour" style={`grid-row:${r + 2};grid-column:1`}>{h}</span>
        <span class="cal-line" style={`grid-row:${r + 2}`}></span>
      </>
    ))}
    {events.map(([col, row, off, time, name, what, color], k) => (
      <div class="cal-ev" style={`grid-column:${col + 1};grid-row:${row + 1};--c:${color};--k:${k};transform:translateY(calc(${off} * 2.55rem))`}>
        <b>{time} {name}</b>
        <span>{what}</span>
      </div>
    ))}
    <span class="cal-now" aria-hidden="true"></span>
  </div>
</div>
