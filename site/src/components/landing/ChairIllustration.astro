---
// Ilustración vectorial del sillón y la lámpara: nítida a cualquier tamaño.
---

<svg class="chair" viewBox="0 0 460 300" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="chSeat" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffffff" stop-opacity=".95"></stop>
      <stop offset="1" stop-color="#8fd3d6" stop-opacity=".55"></stop>
    </linearGradient>
    <linearGradient id="chBack" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ffffff" stop-opacity=".9"></stop>
      <stop offset="1" stop-color="#6cc0c7" stop-opacity=".5"></stop>
    </linearGradient>
    <linearGradient id="chMetal" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#cfe3e8" stop-opacity=".75"></stop>
      <stop offset="1" stop-color="#7fa9b3" stop-opacity=".55"></stop>
    </linearGradient>
    <radialGradient id="chBeam" cx=".5" cy="0" r="1">
      <stop offset="0" stop-color="#fff6d8" stop-opacity=".55"></stop>
      <stop offset="1" stop-color="#fff6d8" stop-opacity="0"></stop>
    </radialGradient>
    <radialGradient id="chFloor" cx=".5" cy=".5" r=".5">
      <stop offset="0" stop-color="#9be3e3" stop-opacity=".45"></stop>
      <stop offset="1" stop-color="#9be3e3" stop-opacity="0"></stop>
    </radialGradient>
  </defs>
  <!-- suelo -->
  <ellipse cx="205" cy="276" rx="190" ry="20" fill="url(#chFloor)"></ellipse>
  <!-- haz de luz de la lámpara -->
  <g class="beam">
    <path d="M330 96 L228 196 L300 214 Z" fill="url(#chBeam)"></path>
  </g>
  <!-- base y columna -->
  <ellipse cx="190" cy="266" rx="92" ry="12" fill="url(#chMetal)"></ellipse>
  <rect x="176" y="190" width="28" height="76" rx="9" fill="url(#chMetal)"></rect>
  <!-- asiento -->
  <path d="M96 188c0-14 10-24 28-24h120c14 0 24 8 24 22v6c0 10-8 16-20 16H122c-16 0-26-8-26-20Z" fill="url(#chSeat)" stroke="#fff" stroke-opacity=".5"></path>
  <!-- respaldo reclinado -->
  <path d="M236 172 306 70c8-12 26-10 32 4l8 22c4 10 0 18-8 26l-84 62c-8 6-18 2-22-8l-8-22c-2-6-2-10 4-12Z" fill="url(#chBack)" stroke="#fff" stroke-opacity=".55"></path>
  <!-- cabecera -->
  <rect x="316" y="46" width="56" height="30" rx="14" transform="rotate(-24 344 61)" fill="url(#chSeat)" stroke="#fff" stroke-opacity=".6"></rect>
  <!-- apoyapiés -->
  <path d="M96 190 50 226c-8 6-6 16 4 16h24c8 0 14-4 20-10l22-26Z" fill="url(#chBack)" stroke="#fff" stroke-opacity=".45"></path>
  <!-- brazo y cabezal de la lámpara -->
  <path d="M400 14c-30 0-52 20-58 52" fill="none" stroke="url(#chMetal)" stroke-width="7" stroke-linecap="round"></path>
  <ellipse cx="338" cy="84" rx="30" ry="11" transform="rotate(-18 338 84)" fill="#e9f7f8" fill-opacity=".9"></ellipse>
  <ellipse cx="338" cy="84" rx="20" ry="6" transform="rotate(-18 338 84)" fill="#fff6d8"></ellipse>
  <!-- bandeja instrumental -->
  <rect x="30" y="150" width="62" height="8" rx="4" fill="url(#chMetal)"></rect>
  <rect x="58" y="158" width="6" height="40" rx="3" fill="url(#chMetal)"></rect>
  <circle cx="40" cy="144" r="4" fill="#bff0f0" fill-opacity=".8"></circle>
  <circle cx="54" cy="142" r="3" fill="#bff0f0" fill-opacity=".6"></circle>
</svg>
