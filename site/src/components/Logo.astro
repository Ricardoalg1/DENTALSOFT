---
interface Props {
  light?: boolean;
}
const { light = false } = Astro.props;
---

<a
  href="/"
  class:list={[
    "inline-flex items-center gap-2.5 text-xl font-semibold tracking-tight",
    light ? "text-white" : "text-teal-950",
  ]}
  aria-label="Occlus, inicio"
  ><span
    class:list={[
      "grid size-9 place-items-center rounded-xl text-lg font-bold",
      light ? "bg-white/15 text-white" : "bg-teal-800 text-white",
    ]}>O</span
  >Occlus<span class="ml-0.5 text-teal-500">.</span></a
>
