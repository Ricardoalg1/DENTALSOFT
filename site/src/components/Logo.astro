---
interface Props {
	light?: boolean;
}
const { light = false } = Astro.props;
---

<a
	href="/"
	class="inline-block overflow-hidden rounded-xl"
	aria-label="Occlus, inicio"
>
	{
		light ? (
			<img
				src="/logo_dark.jpg"
				alt="Occlus App"
				width="960"
				height="598"
				class="h-auto w-36"
			/>
		) : (
			<>
				<img
					src="/logo_light.jpg"
					alt="Occlus — Solución dental digital"
					width="1292"
					height="792"
					class="h-auto w-36 dark:hidden"
				/>
				<img
					src="/logo_dark.jpg"
					alt="Occlus App"
					width="960"
					height="598"
					class="hidden h-auto w-36 dark:block"
				/>
			</>
		)
	}
</a>
