---
import Layout from "../layouts/PublicLayout.astro";
import Icon from "../components/Icon.astro";
import HeroLaptop from "../components/landing/HeroLaptop.astro";
import ModuleGrid from "../components/landing/ModuleGrid.astro";
import CalendarMock from "../components/landing/CalendarMock.astro";
import ChartMock from "../components/landing/ChartMock.astro";
import PhoneMock from "../components/landing/PhoneMock.astro";
import InventoryMock from "../components/landing/InventoryMock.astro";
import ReportsMock from "../components/landing/ReportsMock.astro";
import PlansMock from "../components/landing/PlansMock.astro";
import ChairIllustration from "../components/landing/ChairIllustration.astro";
import "../styles/landing.css";
export const prerender = true;

const trust: [string, string][] = [
  ["shield", "Información segura y separada por clínica"],
  ["cloud", "Acceso desde cualquier dispositivo"],
  ["support", "Soporte en español y acompañamiento"],
  ["cog", "Configuración flexible"],
];
---

<Layout
  title="Producto en detalle"
  description="Agenda, historias clínicas, mensajes, inventario, reportes y planes de Occlus, explicados con vistas de ejemplo."
>
  <div class="landing">
    <div class="mx-auto max-w-[1600px] px-3 pb-6 pt-3 sm:px-4">
      <a href="/" class="link-arrow mb-3 ml-2"><span aria-hidden="true">←</span> Volver al inicio</a>
      <div class="grid gap-3 lg:grid-cols-12">
        <!-- ===================== HERO ===================== -->
        <section class="tile hero is-in lg:col-span-8" aria-labelledby="hero-title">
          <div class="hero-bokeh" aria-hidden="true"><i></i><i></i><i></i></div>
          <svg class="hero-leaf left-[-3rem] top-[-1rem]" viewBox="0 0 200 220" aria-hidden="true">
            <defs>
              <linearGradient id="leaf" x1="0" y1="1" x2="1" y2="0">
                <stop offset="0" stop-color="#5fa98f"></stop>
                <stop offset="1" stop-color="#a9d9c2"></stop>
              </linearGradient>
            </defs>
            <g fill="url(#leaf)">
              <ellipse cx="70" cy="110" rx="26" ry="86" transform="rotate(-24 70 110)"></ellipse>
              <ellipse cx="118" cy="104" rx="22" ry="78" transform="rotate(14 118 104)"></ellipse>
              <ellipse cx="38" cy="150" rx="18" ry="62" transform="rotate(-52 38 150)"></ellipse>
            </g>
          </svg>

          <div class="relative z-10 p-6 sm:p-10 xl:min-h-[31rem] xl:p-12">
            <div class="xl:max-w-[42%] xl:pb-14">
              <a href="#producto" class="rise eyebrow hero-badge inline-flex items-center gap-2 rounded-full border border-border bg-card/70 px-4 py-2 backdrop-blur" style="--d:0">
                Tu clínica, en sintonía <Icon name="arrow" class="size-3" />
              </a>
              <h1 id="hero-title" class="hero-title rise mt-6" style="--d:1">
                Menos pendientes.<br />
                <span class="shimmer">Más sonrisas.</span>
              </h1>
              <p class="rise mt-6 max-w-md text-[1.02rem] leading-8 text-muted-foreground" style="--d:2">
                Occlus conecta la agenda, las historias clínicas y la operación de tu equipo. Todo en un mismo lugar, para que puedas concentrarte en tus pacientes.
              </p>
              <div class="rise mt-8 flex flex-wrap gap-3" style="--d:3">
                <a href="/demo" class="btn btn-lg btn-solid-deep btn-glow">Solicitar demo <Icon name="arrow" class="size-4" /></a>
                <a href="#producto" class="btn btn-lg btn-outline bg-card/60 backdrop-blur">Conoce Occlus</a>
              </div>
              <p class="rise check-row mt-7 flex flex-wrap gap-x-5 gap-y-2 text-xs text-muted-foreground" style="--d:4">
                <span><Icon name="check" class="size-3.5" />Fácil de usar</span>
                <span><Icon name="check" class="size-3.5" />Seguro y confiable</span>
                <span><Icon name="check" class="size-3.5" />Desde cualquier dispositivo</span>
              </p>
            </div>
            <div class="rise hero-laptop mt-10 xl:mt-0" style="--d:3">
              <HeroLaptop />
            </div>
          </div>
        </section>

        <!-- ===================== MÓDULOS ===================== -->
        <section id="producto" class="tile p-6 sm:p-8 lg:col-span-4" data-reveal aria-labelledby="mods-title">
          <p class="eyebrow">Todo en un mismo lugar</p>
          <h2 id="mods-title" class="tile-title mt-3 text-[clamp(1.6rem,2.4vw,2.25rem)]">
            Un software completo para la gestión de tu clínica
          </h2>
          <p class="mt-4 max-w-md text-sm leading-7 text-muted-foreground">
            Organiza tu agenda, atiende a tus pacientes, controla tus insumos y lleva un seguimiento claro de tu operación.
          </p>
          <div class="mt-8"><ModuleGrid /></div>
        </section>

        <!-- ===================== AGENDA ===================== -->
        <article id="agenda" class="tile tile-hover @container p-6 sm:p-7 lg:col-span-4" data-reveal style="--i:1">
          <div class="feature-grid gap-5 @md:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] @md:items-center">
            <div>
              <p class="eyebrow">Agenda</p>
              <h3 class="tile-title mt-3">Una agenda que fluye con tu equipo</h3>
              <p class="mt-3 text-sm leading-7 text-muted-foreground">
                Coordina citas, profesionales y sedes desde una vista clara y moderna. Arrastra, reprograma y mantén todo bajo control.
              </p>
              <a href="/demo" class="tile-link mt-5">Conoce la agenda <Icon name="arrow" class="size-4" /></a>
            </div>
            <CalendarMock />
          </div>
        </article>

        <!-- ===================== HISTORIAS ===================== -->
        <article id="historias" class="tile tile-hover @container p-6 sm:p-7 lg:col-span-4" data-reveal style="--i:2">
          <div class="feature-grid gap-5 @md:grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)] @md:items-center">
            <div>
              <p class="eyebrow">Historias clínicas</p>
              <h3 class="tile-title mt-3">Cada historia, en un solo lugar</h3>
              <p class="mt-3 text-sm leading-7 text-muted-foreground">
                Consulta evoluciones, odontograma, imágenes, archivos y consentimientos con acceso rápido y seguro.
              </p>
              <a href="/demo" class="tile-link mt-5">Ver historias clínicas <Icon name="arrow" class="size-4" /></a>
            </div>
            <ChartMock />
          </div>
        </article>

        <!-- ===================== MENSAJES ===================== -->
        <article id="mensajes" class="tile tile-hover @container p-6 sm:p-7 lg:col-span-4" data-reveal style="--i:3">
          <div class="feature-grid gap-5 @md:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)] @md:items-center">
            <div>
              <p class="eyebrow">Mensajes y recordatorios</p>
              <h3 class="tile-title mt-3">Pacientes más puntuales</h3>
              <p class="mt-3 text-sm leading-7 text-muted-foreground">
                Envía recordatorios por WhatsApp, confirma citas y automatiza la comunicación con tus pacientes.
              </p>
              <a href="/demo" class="tile-link mt-5">Configurar recordatorios <Icon name="arrow" class="size-4" /></a>
            </div>
            <div class="peek"><PhoneMock /></div>
          </div>
        </article>

        <!-- ===================== INVENTARIO ===================== -->
        <article id="inventario" class="tile tile-hover @container p-6 sm:p-7 lg:col-span-4" data-reveal>
          <div class="feature-grid gap-5 @md:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] @md:items-center">
            <div>
              <p class="eyebrow">Inventario</p>
              <h3 class="tile-title mt-3">Insumos bajo control</h3>
              <p class="mt-3 text-sm leading-7 text-muted-foreground">
                Registra existencias, movimientos y lotes. Consulta los vencimientos y evita interrupciones en tu operación.
              </p>
              <a href="/demo" class="tile-link mt-5">Ver inventario <Icon name="arrow" class="size-4" /></a>
            </div>
            <InventoryMock />
          </div>
        </article>

        <!-- ===================== REPORTES ===================== -->
        <article id="reportes" class="tile tile-hover @container p-6 sm:p-7 lg:col-span-4" data-reveal style="--i:1">
          <div class="feature-grid gap-5 @md:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] @md:items-center">
            <div>
              <p class="eyebrow">Reportes</p>
              <h3 class="tile-title mt-3">Decisiones con datos reales</h3>
              <p class="mt-3 text-sm leading-7 text-muted-foreground">
                Visualiza tu producción, recaudo, asistencia y mucho más, con reportes claros y exportables.
              </p>
              <a href="/demo" class="tile-link mt-5">Ver reportes <Icon name="arrow" class="size-4" /></a>
            </div>
            <ReportsMock />
          </div>
        </article>

        <!-- ===================== PLANES ===================== -->
        <article id="planes" class="tile tile-hover @container p-6 sm:p-7 lg:col-span-4" data-reveal style="--i:2">
          <div class="feature-grid gap-6 @lg:grid-cols-[minmax(0,0.75fr)_minmax(0,1.25fr)] @lg:items-center">
            <div>
              <p class="eyebrow">Planes</p>
              <h3 class="tile-title mt-3">Un plan para cada etapa de tu clínica</h3>
              <p class="mt-3 text-sm leading-7 text-muted-foreground">
                Elige el plan que se adapta al tamaño de tu equipo y crece sin complicaciones.
              </p>
              <a href="/planes" class="tile-link mt-5">Ver todos los planes <Icon name="arrow" class="size-4" /></a>
            </div>
            <PlansMock />
          </div>
        </article>

        <!-- ===================== BANDA FINAL ===================== -->
        <section class="tile band relative min-h-[16rem] p-8 sm:p-10 lg:col-span-5" data-reveal aria-labelledby="band-title">
          <ChairIllustration />
          <div class="relative ml-auto max-w-[13rem] pt-2 text-right sm:max-w-[15rem]">
            <p class="eyebrow !text-[#8fdcdc]">Más que un software</p>
            <h2 id="band-title" class="mt-3 text-2xl font-semibold leading-tight tracking-tight text-white">Un mismo lugar para tu operación.</h2>
          </div>
        </section>

        <section class="tile grid place-items-center p-6 lg:col-span-4" data-reveal style="--i:1" aria-label="Por qué Occlus">
          <ul class="grid w-full grid-cols-2 gap-6 sm:grid-cols-4 lg:grid-cols-4">
            {trust.map(([icon, html], i) => (
              <li class="flex flex-col items-center gap-3 text-center text-[0.78rem] leading-snug text-muted-foreground [text-wrap:balance]" style={`--i:${i}`}>
                <span class="trust-ico grid size-12 place-items-center rounded-full border border-border bg-accent text-primary"><Icon name={icon} class="size-6" /></span>
                <span set:html={html} />
              </li>
            ))}
          </ul>
        </section>

        <section class="cta-card tile !border-0 p-8 sm:p-10 lg:col-span-3" data-reveal style="--i:2" aria-labelledby="cta-title">
          <p class="eyebrow !text-[#8fdcdc]">Tu clínica, en sintonía</p>
          <h2 id="cta-title" class="mt-3 text-2xl font-semibold leading-tight tracking-tight sm:text-[1.7rem]">
            ¿Listo para llevar tu clínica al siguiente nivel?
          </h2>
          <a href="/demo" class="btn btn-white btn-lg mt-7">Solicitar demo <Icon name="arrow" class="size-4" /></a>
        </section>
      </div>

      <p class="sample-note mx-auto mt-5 max-w-3xl px-4 text-center">
        Vistas ilustrativas con datos de ejemplo. La emisión electrónica con un proveedor, los envíos por WhatsApp y el asistente IA requieren configuración y activación: revisamos su disponibilidad y alcance contigo.
      </p>
    </div>
  </div>
</Layout>
