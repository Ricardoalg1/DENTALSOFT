---
import Layout from "../layouts/PublicLayout.astro";
import Icon from "../components/Icon.astro";
export const prerender = true;
const features = [
  [
    "calendar",
    "Una agenda que fluye",
    "Coordina citas, profesionales y sedes. Dale a recepción una visión clara del día.",
  ],
  [
    "clinical",
    "Cada historia, en su lugar",
    "Reúne evoluciones, odontograma y archivos con acceso según el rol del equipo.",
  ],
  [
    "wallet",
    "De la propuesta al pago",
    "Organiza tratamientos y presupuestos. Registra cobros y movimientos de caja.",
  ],
  [
    "box",
    "Insumos bajo control",
    "Consulta existencias, registra consumos y revisa lotes y fechas de vencimiento.",
  ],
  [
    "chart",
    "Datos para decidir",
    "Revisa la actividad de tu clínica y los ingresos para planear el siguiente paso.",
  ],
  [
    "team",
    "Tu equipo, conectado",
    "Define roles y organiza sedes con información compartida dentro de tu clínica.",
  ],
];
---

<Layout
  ><section class="section grid items-center gap-12 lg:grid-cols-[1fr_1.05fr]">
    <div>
      <p
        class="eyebrow inline-flex items-center gap-2 rounded-full border border-teal-800/20 bg-white/60 px-4 py-2"
      >
        <span class="size-1.5 rounded-full bg-teal-600"></span>Tu clínica, en
        sintonía
      </p><h1
        class="mt-7 text-5xl font-semibold leading-[1.06] tracking-[-.045em] sm:text-6xl lg:text-7xl"
      >
        Menos pendientes.<br /><span class="text-teal-800">Más sonrisas.</span>
      </h1><p class="mt-7 max-w-lg text-lg leading-8 text-slate-600">
        Occlus conecta la agenda, las historias clínicas y la operación de tu
        equipo. Todo encuentra su lugar, para que puedas concentrarte en tus
        pacientes.
      </p><div class="mt-9 flex flex-wrap gap-3">
        <a href="/demo" class="btn"
          >Conoce Occlus <Icon name="arrow" class="size-4" /></a
        ><a href="/planes" class="btn btn-outline">Explorar planes</a>
      </div><p class="mt-5 text-xs text-slate-500">
        Desde $99.000 COP al mes · Para equipos de 1 a 5 usuarios
      </p>
    </div><div class="relative">
      <div
        class="absolute -left-4 -top-5 size-36 rounded-full bg-[#d6e8b5] blur-2xl"
        aria-hidden="true"
      >
      </div><div
        class="relative overflow-hidden rounded-[2rem] border border-teal-800/15 bg-white shadow-2xl shadow-teal-950/10"
      >
        <div
          class="flex items-center justify-between border-b border-teal-900/10 bg-teal-900 px-5 py-4 text-white"
        >
          <span class="text-sm font-semibold">O · Occlus</span><span
            class="text-[10px] text-teal-100">Clínica de ejemplo</span>
        </div><div class="grid grid-cols-[44px_1fr] sm:grid-cols-[120px_1fr]">
          <div
            class="border-r border-teal-900/10 bg-[#f3f6ef] px-3 py-5 text-xs text-teal-950/60"
          >
            <div class="mb-4 flex gap-2 rounded-lg bg-teal-800 p-2 text-white">
              <Icon name="calendar" class="size-4" /><span
                class="hidden sm:inline">Agenda</span>
            </div>{
              [
                ["clinical", "Historias"],
                ["wallet", "Caja"],
                ["box", "Inventario"],
                ["chart", "Reportes"],
              ].map(([icon, title]) => (
                <div class="mb-4 flex items-center gap-2 p-2">
                  <>
                    <Icon name={icon} class="size-4" />
                    <span class="hidden sm:inline">{title}</span>
                  </>
                </div>
              ))
            }
          </div><div class="p-4 sm:p-6">
            <div class="flex items-start justify-between">
              <div>
                <p class="text-xs text-slate-400">
                  Así se ve un día organizado
                </p><h2 class="mt-1 text-lg font-semibold">
                  Agenda del equipo
                </h2>
              </div><span class="rounded-lg border px-2 py-1 text-[10px]"
                >Vista diaria</span>
            </div><div class="mt-5 grid grid-cols-3 gap-2">
              {
                [
                  ["08", "Citas"],
                  ["03", "Profesionales"],
                  ["02", "Sedes"],
                ].map(([v, l]) => (
                  <div class="rounded-xl bg-[#f4f6ef] p-3">
                    <>
                      <strong class="text-xl font-semibold">{v}</strong>
                      <p class="mt-1 text-[10px] text-slate-500">{l}</p>
                    </>
                  </div>
                ))
              }
            </div><div class="mt-5 space-y-3">
              {
                [
                  ["09:00", "Valoración inicial", "Confirmada", "bg-teal-50"],
                  [
                    "10:00",
                    "Control de tratamiento",
                    "En atención",
                    "bg-lime-50",
                  ],
                  ["11:30", "Seguimiento", "Programada", "bg-slate-50"],
                ].map(([time, title, status, color]) => (
                  <div
                    class:list={[
                      "flex items-center gap-3 rounded-xl border border-teal-800/10 p-3",
                      color,
                    ]}
                  >
                    <>
                      <span class="text-[10px] text-slate-400">{time}</span>
                      <div class="min-w-0 flex-1">
                        <>
                          <p class="text-xs font-semibold">{title}</p>
                          <p class="mt-1 text-[10px] text-slate-400">
                            Paciente de ejemplo
                          </p>
                        </>
                      </div>
                      <span class="hidden rounded-full bg-white px-2 py-1 text-[9px] text-teal-800 sm:block">
                        {status}
                      </span>
                    </>
                  </div>
                ))
              }
            </div><div
              class="mt-5 flex items-center gap-2 text-[10px] text-slate-400"
            >
              <Icon name="shield" class="size-3" />Acceso según el rol del
              equipo
            </div>
          </div>
        </div>
      </div><p class="mt-4 text-center text-[10px] text-slate-400">
        Vista ilustrativa · Datos de ejemplo
      </p>
    </div>
  </section><div class="border-y border-teal-950/10 bg-white/60">
    <div
      class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-5 px-6 py-6 text-sm text-teal-900"
    >
      <span class="font-semibold">Un mismo lugar para tu operación</span>{
        [
          "Agenda",
          "Historia clínica",
          "Presupuestos",
          "Caja",
          "Inventario",
        ].map((t) => (
          <span class="flex items-center gap-2">
            <Icon name="check" class="size-4" />
            {t}
          </span>
        ))
      }
    </div>
  </div><section id="producto" class="section">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="eyebrow">Todo encuentra su lugar</p><h2
          class="mt-4 max-w-2xl text-3xl font-semibold leading-tight tracking-tight md:text-5xl"
        >
          El día a día de tu clínica,<br />con un poco más de calma.
        </h2>
      </div><p class="max-w-sm text-sm leading-7 text-slate-500">
        Herramientas prácticas para coordinar el trabajo clínico, administrativo
        y de recepción.
      </p>
    </div><div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        features.map(([icon, title, text]) => (
          <article class="rounded-2xl border border-teal-950/10 bg-white p-7">
            <>
              <div class="grid size-12 place-items-center rounded-xl bg-[#edf3e8] text-teal-800">
                <Icon name={icon} />
              </div>
              <h3 class="mt-6 text-xl font-semibold tracking-tight">{title}</h3>
              <p class="mt-3 text-sm leading-7 text-slate-500">{text}</p>
            </>
          </article>
        ))
      }
    </div>
  </section><section class="mx-auto max-w-7xl px-6 pb-20">
    <div
      class="grid gap-10 rounded-[2rem] bg-[#e4edd9] p-8 md:grid-cols-2 md:p-12"
    >
      <div>
        <p class="eyebrow">Una clínica. Un equipo.</p><h2
          class="mt-4 text-3xl font-semibold tracking-tight"
        >
          Crece con una operación más clara.
        </h2><p class="mt-5 text-sm leading-7 text-slate-600">
          Desde un consultorio hasta un equipo con varias sedes, Occlus te ayuda
          a organizar la información y los permisos de tu clínica.
        </p><a href="/planes" class="btn mt-7"
          >Encuentra tu plan <Icon name="arrow" class="size-4" /></a>
      </div><ol class="space-y-5">
        {
          [
            [
              "01",
              "Cuéntanos cómo trabajas",
              "Conocemos el tamaño del equipo y lo que necesitas organizar.",
            ],
            [
              "02",
              "Revisa los flujos en una demo",
              "Exploramos agenda, historia clínica y gestión con ejemplos.",
            ],
            [
              "03",
              "Define el siguiente paso",
              "Acordamos plan, configuración y alcance para tu operación.",
            ],
          ].map(([number, title, text]) => (
            <li class="flex gap-4 rounded-2xl bg-white/60 p-5">
              <>
                <span class="text-xs font-semibold text-teal-700">
                  {number}
                </span>
                <div>
                  <>
                    <h3 class="font-semibold">{title}</h3>
                    <p class="mt-2 text-sm leading-6 text-slate-500">{text}</p>
                  </>
                </div>
              </>
            </li>
          ))
        }
      </ol>
    </div>
  </section><section class="mx-auto max-w-7xl px-6 pb-20">
    <div class="grid gap-8 md:grid-cols-2">
      <div>
        <p class="eyebrow">Complementos e integraciones</p><h2
          class="mt-4 text-3xl font-semibold tracking-tight"
        >
          Conecta lo que tu clínica necesita.
        </h2>
      </div><div>
        <p class="text-sm leading-7 text-slate-600">
          La emisión electrónica a través de un proveedor, los envíos por
          WhatsApp y el asistente IA requieren configuración y activación.
          Revisamos su disponibilidad y alcance contigo antes de incorporarlos a
          tu operación.
        </p><a
          href="/demo"
          class="mt-5 inline-flex gap-2 text-sm font-semibold text-teal-800"
          >Conversar sobre integraciones <Icon
            name="arrow"
            class="size-4"
          /></a>
      </div>
    </div>
  </section><section class="bg-teal-800 px-6 py-16 text-center text-white">
    <p class="eyebrow text-teal-200">Tu próximo paso</p><h2
      class="mx-auto mt-4 max-w-2xl text-4xl font-semibold tracking-tight"
    >
      Dale a tu clínica el orden que merece.
    </h2><p class="mx-auto mt-5 max-w-xl text-sm leading-7 text-teal-100">
      Conoce Occlus y descubre cómo encaja en la rutina de tu equipo.
    </p><a href="/demo" class="btn mt-7 bg-white text-teal-900 hover:bg-teal-50"
      >Solicitar mi demo <Icon name="arrow" class="size-4" /></a>
  </section></Layout
>
