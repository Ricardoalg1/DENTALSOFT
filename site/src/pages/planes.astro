---
import Layout from "../layouts/PublicLayout.astro";
import Icon from "../components/Icon.astro";
import { plans, money } from "../../../shared/site-content";
export const prerender = true;
---

<Layout
  title="Planes"
  description="Planes para tu clínica desde $99.000 COP al mes. Esencial, Equipo, Integral y Global."
  ><section class="section">
    <div class="text-center">
      <p class="eyebrow">Espacio para crecer</p><h1
        class="mx-auto mt-4 max-w-3xl text-4xl font-semibold leading-tight tracking-tight md:text-5xl"
      >
        Un plan para cada etapa de tu clínica.
      </h1><p class="mt-5 text-slate-500">
        Herramientas compartidas. Acompañamiento según tu operación.
      </p><fieldset
        class="mx-auto mt-8 flex w-fit rounded-full border border-teal-800/20 bg-white p-1"
      >
        <legend class="sr-only">Periodicidad del pago</legend><label
          class="cursor-pointer rounded-full px-5 py-3 text-sm has-checked:bg-teal-800 has-checked:text-white"
          ><input
            class="sr-only"
            type="radio"
            name="period"
            value="monthly"
            checked
          />Mensual</label
        ><label
          class="cursor-pointer rounded-full px-5 py-3 text-sm has-checked:bg-teal-800 has-checked:text-white"
          ><input
            class="sr-only"
            type="radio"
            name="period"
            value="annual"
          />Anual</label>
      </fieldset>
    </div><div class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
      {
        plans.map((p) => (
          <article
            class:list={[
              "relative flex flex-col rounded-3xl border bg-white p-7",
              p.id === "CRECIMIENTO"
                ? "border-teal-700 ring-1 ring-teal-700"
                : "border-teal-950/10",
            ]}
          >
            <>
              <p class="min-h-6 text-xs font-semibold text-teal-700">
                {p.id === "CRECIMIENTO" ? "Para equipos en crecimiento" : " "}
              </p>
              <h2 class="mt-3 text-2xl font-semibold">{p.name}</h2>
              <p class="mt-2 text-sm text-slate-500">{p.users}</p>
              <div class="mt-7 min-h-28">
                {p.monthly !== null && p.annual !== null ? (
                  <>
                    <p class="text-xs text-slate-400">Desde</p>
                    <p
                      data-monthly
                      class="mt-2 text-3xl font-semibold tracking-tight"
                    >
                      ${money(p.monthly)}{" "}
                      <span class="text-xs font-normal">COP/mes</span>
                    </p>
                    <p
                      data-annual
                      hidden
                      class="mt-2 text-3xl font-semibold tracking-tight"
                    >
                      ${money(p.annual / 12)}{" "}
                      <span class="text-xs font-normal">COP/mes</span>
                    </p>
                    <p data-monthly class="mt-3 text-xs text-slate-400">
                      Pago mensual
                    </p>
                    <p data-annual hidden class="mt-3 text-xs text-slate-400">
                      Pagando ${money(p.annual)} COP al año
                    </p>
                  </>
                ) : (
                  <p class="mt-5 text-2xl font-semibold">A tu medida</p>
                )}
              </div>
              <p class="my-6 text-sm leading-7 text-slate-500">
                {p.description}
              </p>
              <ul class="mb-8 space-y-4 text-sm">
                {[...p.focus, p.support].map((f) => (
                  <li class="flex gap-2">
                    <Icon name="check" class="size-4 shrink-0 text-teal-700" />
                    {f}
                  </li>
                ))}
              </ul>
              <a href={`/demo?plan=${p.id}`} class="btn mt-auto">
                {p.monthly === null ? "Contactar un asesor" : "Solicitar demo"}
              </a>
            </>
          </article>
        ))
      }
    </div><div
      class="mx-auto mt-10 max-w-3xl text-center text-sm leading-7 text-slate-500"
    >
      <p>
        Los planes para Colombia comparten agenda, historias, presupuestos,
        caja, inventario y reportes. Las tarjetas destacan prioridades de uso
        para cada tamaño de equipo.
      </p><p class="mt-4">
        La propuesta confirmará impuestos, alcance y acompañamiento. Las
        integraciones externas y adaptaciones internacionales se evalúan por
        separado. No se realizan cobros en este sitio.
      </p><a href="/condiciones" class="mt-4 inline-block underline"
        >Consultar condiciones comerciales</a>
    </div><noscript
      ><p class="mt-6 text-center text-sm">
        Precios anuales: Esencial $990.000, Equipo $1.788.000 e Integral
        $2.388.000 COP por año.
      </p></noscript>
  </section></Layout
><script>
  document
    .querySelectorAll<HTMLInputElement>('input[name="period"]')
    .forEach((input) =>
      input.addEventListener("change", () => {
        const annual = input.value === "annual";
        document
          .querySelectorAll<HTMLElement>("[data-monthly]")
          .forEach((el) => (el.hidden = annual));
        document
          .querySelectorAll<HTMLElement>("[data-annual]")
          .forEach((el) => (el.hidden = !annual));
      }),
    );
</script>
