---
import Layout from "../layouts/PublicLayout.astro";
export const prerender = true;
---

<Layout title="Solicitud recibida" noindex
  ><section class="section max-w-2xl text-center">
    <p class="eyebrow">Tu siguiente paso</p><h1
      class="mt-4 text-4xl font-semibold"
    >
      Recibimos tu solicitud.
    </h1><p class="mt-6 leading-8 text-slate-500">
      El equipo de Occlus revisará la información para coordinar contigo una
      demostración.
    </p><a href="/planes" class="btn mt-8">Volver a los planes</a>
  </section></Layout
>
