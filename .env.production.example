PUBLIC_DOMAIN=occlus.lat
TLS_EMAIL=
DB_URL=jdbc:postgresql://ENDPOINT_RDS:5432/occlus?sslmode=verify-full&sslrootcert=/app/certs/global-bundle.pem
DB_USER=occlus_app
DB_PASSWORD=
DB_MIGRATION_USER=occlus
DB_MIGRATION_PASSWORD=
JWT_SECRET=
SITE_PUBLIC_API_KEY=
OCCLUS_PLATFORM_ADMIN_IDS=
# Panel de plataforma: días de gracia tras vencer una suscripción y proceso automático de cobros.
SUBSCRIPTION_GRACE_DAYS=7
SUBSCRIPTIONS_SCHEDULER=true
SITE_OWNER_NAME=SINE SAS
SITE_CONTACT_NAME=Ricardo Algarin
SITE_CONTACT_EMAIL=
SITE_ANALYTICS_ENABLED=false
SITE_RETENTION_ENABLED=false
SITE_RETENTION_DAYS=0
# Solo publicar el plazo cuando coincida con la política activada en backend.
SITE_RETENTION_PUBLIC_DAYS=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=

# --- Pagos de la suscripción (ver docs/phase-13-payments.md) ---
# Wompi: llaves del panel de comercio (Desarrolladores). En producción: pub_prod_ / prv_prod_.
WOMPI_ENABLED=false
WOMPI_ENVIRONMENT=production
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
# ePayco: Configuración > Integraciones > Llaves API (P_CUST_ID_CLIENTE, PUBLIC_KEY, P_KEY).
EPAYCO_ENABLED=false
EPAYCO_CUSTOMER_ID=
EPAYCO_PUBLIC_KEY=
EPAYCO_P_KEY=
EPAYCO_TEST=false

# Correo clínico: desactivado hasta configurar y validar el proveedor.
CLINICAL_MAIL_ENABLED=false
CLINICAL_MAIL_HOST=
CLINICAL_MAIL_PORT=587
CLINICAL_MAIL_USERNAME=
CLINICAL_MAIL_PASSWORD=
CLINICAL_MAIL_FROM=
CLINICAL_MAIL_SSL=false
